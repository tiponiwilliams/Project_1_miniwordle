<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:background="@color/black"
    android:padding="16dp">

    <TextView
        android:id="@+id/title"
        android:layout_width="0dp"
        android:gravity="center"
        android:layout_height="wrap_content"
        android:text="Mini Wordle Game"
        android:textColor="@color/white"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <EditText
        android:id="@+id/guessInput"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="Enter 4-letter guess"
        android:textColorHint="@color/white"
        android:imeOptions="actionDone"
        android:importantForAutofill="no"
        android:inputType="textCapCharacters"
        android:maxLength="4"
        android:textColor="@color/white"
        app:layout_constraintEnd_toStartOf="@id/submitButton"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imageView" />

    <Button
        android:id="@+id/submitButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Submit"
        android:backgroundTint="@color/green"
        app:layout_constraintTop_toTopOf="@id/guessInput"
        app:layout_constraintBottom_toBottomOf="@id/guessInput"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Row 1 -->
    <TextView
        android:id="@+id/guess1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Guess 1:"
        android:textStyle="bold"
        android:textColor="@color/yellow"
        app:layout_constraintTop_toBottomOf="@id/guessInput"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/result1"
        app:layout_constraintHorizontal_weight="1"
        android:paddingTop="16dp" />

    <TextView
        android:id="@+id/result1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/green"
        android:text="—"
        app:layout_constraintBaseline_toBaselineOf="@id/guess1"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Row 2 -->
    <TextView
        android:id="@+id/guess2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Guess 2:"
        android:textStyle="bold"
        android:textColor="@color/yellow"
        app:layout_constraintTop_toBottomOf="@id/guess1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/result2"
        app:layout_constraintHorizontal_weight="1"
        android:paddingTop="8dp" />

    <TextView
        android:id="@+id/result2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="—"
        android:textColor="@color/green"
        app:layout_constraintBaseline_toBaselineOf="@id/guess2"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Row 3 -->
    <TextView
        android:id="@+id/guess3"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Guess 3:"
        android:textStyle="bold"
        android:textColor="@color/yellow"
        app:layout_constraintTop_toBottomOf="@id/guess2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/result3"
        app:layout_constraintHorizontal_weight="1"
        android:paddingTop="8dp" />

    <TextView
        android:id="@+id/result3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="—"
        android:textColor="@color/green"
        app:layout_constraintBaseline_toBaselineOf="@id/guess3"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/answerText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@color/yellow"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/guess3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:paddingTop="16dp" />

    <Button
        android:id="@+id/resetButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Reset"
        android:backgroundTint="@color/green"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/answerText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:paddingTop="8dp" />

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="232dp"
        android:layout_height="81dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.498"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title"
        app:srcCompat="@drawable/wordle_logo" />


</androidx.constraintlayout.widget.ConstraintLayout>